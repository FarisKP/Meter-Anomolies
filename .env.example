# CSV is the default and needs no credentials.
DATA_BACKEND=csv

# Set DATA_BACKEND=supabase only after the schema and data are available.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_replace_me
# SUPABASE_HISTORY_BATCH_ID=history-csv-initial
# SUPABASE_CURRENT_BATCH_ID=current-csv-initial
# SUPABASE_ANALYSIS_RUN_ID=csv-analysis-initial

# Optional: resolve service premises from the authorised internal source before
# weather investigation. Do not put these values in browser/Vite variables.
# ENABLE_PREMISE_SOURCE_RESOLUTION=true
# PREMISE_SOURCE_BASE_URL=https://internal.example/api
# PREMISE_SOURCE_API_KEY=server_only_secret
# PREMISE_SOURCE_NAME=customer-service-premise
# ENABLE_WEATHER_INVESTIGATION=true
